{"nodes": [{"id": "readme_quantum_doom", "label": "Quantum Doom", "file_type": "document", "source_file": "README.md", "source_location": "L1-9", "rationale": "Aim is feasibility, not quantum advantage: can a simulated variational quantum circuit act as a PPO policy in ViZDoom, culminating in completing E1M1 without dying", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_variational_quantum_circuit_policy", "label": "Variational Quantum Circuit Policy", "file_type": "concept", "source_file": "README.md", "source_location": "L3-9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_data_reuploading_pqc", "label": "Data Re-uploading PQC", "file_type": "concept", "source_file": "README.md", "source_location": "L13-36", "rationale": "Per layer per qubit RX(x*lambda)->RY->RZ then ring of CNOTs, 4 layers, measure <Z> on every qubit; simulated with PennyLane default.qubit via torch backprop on GPU; entangle=False ablation, noise_p>0 uses default.mixed depolarising noise", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_hand_crafted_angle_features", "label": "Hand-crafted angle features (depth + labels buffers)", "file_type": "concept", "source_file": "README.md", "source_location": "L30-33", "rationale": "No CNN: each frame reduced to one angle per qubit using depth and labels buffers (exact segmentation); 8 FOV sectors positive for monsters, negative with wall distance", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ppo_with_gae", "label": "PPO with GAE", "file_type": "concept", "source_file": "README.md", "source_location": "L39-40", "rationale": "Clipped objective with gym.vector envs (Sync for ablation, Async elsewhere)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_classical_mlp_critic", "label": "Classical MLP Critic", "file_type": "concept", "source_file": "README.md", "source_location": "L27,L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_pennylane", "label": "PennyLane", "file_type": "concept", "source_file": "README.md", "source_location": "L34,L68-71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_vizdoom", "label": "ViZDoom", "file_type": "concept", "source_file": "README.md", "source_location": "L4,L71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_e1m1_hangar", "label": "E1M1 (Hangar)", "file_type": "concept", "source_file": "README.md", "source_location": "L5,L134-188", "rationale": "Final goal: finish E1M1 with health > 0 in greedy evaluation over >=20 episodes at skill 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_doom1_wad", "label": "Shareware doom1.wad v1.9", "file_type": "concept", "source_file": "README.md", "source_location": "L73-75", "rationale": "Freedoom's E1M1 bundled with ViZDoom is a different map, so the original shareware WAD is required", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_slurm_cluster_execution", "label": "Slurm cluster execution", "file_type": "concept", "source_file": "README.md", "source_location": "L77-94", "rationale": "Anything that starts ViZDoom or torch runs via sbatch, not on the login node", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_entanglement_ablation", "label": "Entanglement ablation (basic.cfg)", "file_type": "concept", "source_file": "README.md", "source_location": "L100-110", "rationale": "Without CNOTs each <Z_i> depends only on x_i so the unentangled actor cannot model feature interactions; MLP 10.1 > entangled PQC 8.4 > unentangled -1.7; not parameter/lr matched", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_deadly_corridor", "label": "Deadly Corridor scenario", "file_type": "concept", "source_file": "README.md", "source_location": "L112-118", "rationale": "Agent presses FORWARD ~95-100%; x-progress rewarded twice outweighs death penalty, so not evidence the agent uses observations", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_my_way_home", "label": "My Way Home scenario", "file_type": "concept", "source_file": "README.md", "source_location": "L120-132", "rationale": "Quantum agent 14/20 greedy vs random 2/20; qubit 9 proximity uses true goal distance, not vision", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_take_cover_dodging", "label": "Take Cover dodging task", "file_type": "concept", "source_file": "README.md", "source_location": "L200-207", "rationale": "No convincing improvement over random; radar observation needs projectile/motion info before quantum-vs-classical comparison is meaningful", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_e1m1_pipeline", "label": "E1M1 pipeline", "file_type": "concept", "source_file": "README.md", "source_location": "L134-188", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_e1m1_12_qubit_observation", "label": "E1M1 12-qubit observation", "file_type": "concept", "source_file": "README.md", "source_location": "L141-152", "rationale": "Qubits 0-7 FOV sectors, 8 bearing to waypoint/exit, 9 waypoint proximity, 10 health, 11 door/exit ahead; reward: waypoint progress, damage -0.05/HP, kill +2, death -50, exit +100; timeouts returned as truncated", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_route_planner_dijkstra", "label": "Route planner (grid Dijkstra)", "file_type": "concept", "source_file": "README.md", "source_location": "L153-159", "rationale": "16-unit grid, blocks walls within player radius, step-ups >24, gaps <56; penalises nukage; boolean-mask bug once produced a route through a wall; corrected route 22 waypoints ~4972 units", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_route_validation_scripted_follower", "label": "Route validation (scripted follower)", "file_type": "concept", "source_file": "README.md", "source_location": "L160-163", "rationale": "Gate: training checks for at least one skill-3 exit before spending GPU time", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_quantum_only_policy_value_model", "label": "Quantum-only policy and value model", "file_type": "concept", "source_file": "README.md", "source_location": "L164-169", "rationale": "12 qubits, 2 re-uploading layers; 7 Pauli-Z expectations as action logits, 8th as value; no classical MLP or learned linear readout; scalar gains only", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_reverse_start_curriculum", "label": "Reverse-start curriculum", "file_type": "concept", "source_file": "README.md", "source_location": "L170-181,L431-435", "rationale": "Starts at waypoints 21,20,19,16,12,6 then true start; advances after >=3 exits in latest 20 episodes; chosen because scripted exits succeed from waypoint 19/16 but warping to door waypoint 17 stalls; neither fixed nor adaptive run completed E1M1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_circuit_imitation_test", "label": "Circuit imitation test", "file_type": "concept", "source_file": "README.md", "source_location": "L182-186", "rationale": "Fitted circuit to 2,184 scripted actions: 59.2% accuracy, 0/5 wins; scripted follower still reaches waypoint 21-22 so stall is not evidence the observation is unusable", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_classical_subtask_baselines", "label": "Classical subtask baselines", "file_type": "concept", "source_file": "README.md", "source_location": "L190-225", "rationale": "Classical MLP actor/critic on the same compact observations as feasibility check; combat collapses to ATTACK, navigation modestly improves, dodge no better than random; more rollouts did not fix combat collapse", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_screen_only_navigation_memory", "label": "Screen-only navigation memory experiment", "file_type": "concept", "source_file": "README.md", "source_location": "L227-264", "rationale": "Policy sees only RGB-derived features plus optional 4-value travel map from action odometry; no reliable memory benefit over 20 episodes; map drifts without place recognition and RGB sector compression discards much of the image", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_action_based_travel_map", "label": "Action-based travel map", "file_type": "concept", "source_file": "README.md", "source_location": "L229-234,L257-260", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_human_visible_observation", "label": "Human-visible observation constraint", "file_type": "rationale", "source_file": "README.md", "source_location": "L229-233,L272-277", "rationale": "Policy must not read engine position, depth, labels, objects, goal coordinates or WAD map; only screen-derived input (with privileged training feedback via reward)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_private_progress_kill_rewards", "label": "Private progress and kill rewards", "file_type": "concept", "source_file": "README.md", "source_location": "L266-295", "rationale": "Potential-based reward from distance change to endpoint plus kill bonus; privileged info used only in reward, never policy input; did not improve held-out item collection", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_potential_based_reward_shaping", "label": "Potential-based reward shaping", "file_type": "concept", "source_file": "README.md", "source_location": "L268-271", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rgb_place_memory", "label": "RGB place memory (VisualPlaceMemory)", "file_type": "concept", "source_file": "README.md", "source_location": "L297-307", "rationale": "Augments travel grid with RGB keyframes, visual revisit matching and links between cells; still reads no engine pose", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_memory_bridges", "label": "Memory bridges (controlled rotations)", "file_type": "concept", "source_file": "README.md", "source_location": "L303-307", "rationale": "Trainable controlled rotations from each memory qubit to every action/value readout raise turn-logit sensitivity to memory features, which was near zero in the original circuit", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_matched_policy_comparison", "label": "Matched classical vs bridged-quantum comparison", "file_type": "concept", "source_file": "README.md", "source_location": "L309-330", "rationale": "Neither distinguishable from random (Fisher p~0.6); seed 20017 accounts for most successes; fixed RGB sector summaries and budget more likely bottleneck than policy model", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_learned_screen_encoder", "label": "Learned screen encoder (CNN to 12-value bottleneck)", "file_type": "concept", "source_file": "README.md", "source_location": "L332-341", "rationale": "Four stacked 80x60 RGB screens with HUD through small CNN into 12 values in [-pi,pi]; identical encoder for classical and circuit heads so the head is the only variable", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_auxiliary_losses", "label": "Auxiliary depth and goal-visibility losses", "file_type": "concept", "source_file": "README.md", "source_location": "L343-347", "rationale": "Training-only linear head predicts per-sector log depth and goal visibility; goal pixels ~1% of sectors so pos_weight=20; targets never policy inputs", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_success_detection_bug", "label": "Success-detection bug", "file_type": "concept", "source_file": "README.md", "source_location": "L366-377", "rationale": "Vest +1 reward can land before episode end so raw_reward > 0 missed pickups; fixed with get_total_reward() > 0.5 in HumanNavigationEnv and PixelNavigationEnv; doom_nav_env.py still uses old test", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_circuit_head_result", "label": "12-qubit circuit head result (96/100)", "file_type": "concept", "source_file": "README.md", "source_location": "L394-412", "rationale": "Circuit head reaches vest from screen alone on 96/100 unseen spawns vs classical 99-100; ~9x slower; CNN does most perception so this shows trainability, not circuit contribution; needs linear-readout control and more seeds", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_freinberger_et_al_2024", "label": "Freinberger et al. 2024 (hybrid Atari)", "file_type": "paper", "source_file": "README.md", "source_location": "L334-335", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_mirowski_et_al_2016", "label": "Mirowski et al. 2016 (auxiliary-task navigation)", "file_type": "paper", "source_file": "README.md", "source_location": "L335-336", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_lample_chaplot_2017", "label": "Lample & Chaplot 2017", "file_type": "paper", "source_fi